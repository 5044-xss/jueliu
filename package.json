{
  "name": "jueman",
  "version": "0.1.3",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "npm run electron:dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/gen-icon.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n next,electron \"next dev -p 3000\" \"wait-on http-get://127.0.0.1:3000 && electron .\"",
    "dist": "node scripts/build-desktop.mjs",
    "test:apimart": "node scripts/test-apimart-mock.mjs",
    "test:toapi:mock": "node scripts/test-toapi-mock.mjs",
    "test:qc": "node --experimental-strip-types --test scripts/test-qc.mjs",
    "test:retry": "node --experimental-strip-types --test scripts/test-retry.mjs",
    "test:pipeline": "node --experimental-strip-types --test tests/pipeline/run.mjs",
    "test:pipeline:list": "node --experimental-strip-types tests/pipeline/run.mjs --list",
    "test:script-beats": "node --experimental-strip-types --test scripts/test-script-beats.mjs",
    "state:backfill": "node --experimental-strip-types scripts/backfill-shot-state.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "openai": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^5.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
