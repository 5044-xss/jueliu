{
  "name": "jueliu",
  "version": "0.3.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --mode web",
    "dev:app": "vite --mode desktop",
    "dev:app:mobile": "vite --mode mobile",
    "build:app:desktop": "vite build --mode desktop",
    "build:app:mobile": "vite build --mode mobile",
    "build:app": "npm run build:app:desktop",
    "dev:app:electron": "concurrently -k -n spa,electron \"vite --mode desktop\" \"wait-on http-get://127.0.0.1:5173 && electron .\"",
    "build:app:desktop:dist": "node scripts/build-local-desktop.mjs",
    "build:desktop:local": "node scripts/build-local-desktop.mjs",
    "cap:sync": "node scripts/sync-app-version.mjs && node scripts/gen-mobile-icons.mjs && npm run build:app:mobile && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "android:debug": "node scripts/build-android.mjs",
    "ios:package": "node scripts/build-ios.mjs",
    "license:sign": "node scripts/sign-license.mjs",
    "dev:electron": "npm run dev:app:electron",
    "build": "npm run build:app:desktop",
    "start": "vite preview --mode web",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/gen-icon.mjs && node scripts/gen-mobile-icons.mjs",
    "icon:mobile": "node scripts/gen-mobile-icons.mjs",
    "build:clipboard": "node scripts/build-clipboard-helper.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "electron": "electron .",
    "electron:dev": "npm run dev:app:electron",
    "dist": "npm run build:desktop:local",
    "test:qc": "node --experimental-strip-types --test scripts/test-qc.mjs",
    "test:pipeline": "node --experimental-strip-types --test tests/pipeline/run.mjs",
    "test:pipeline:list": "node --experimental-strip-types tests/pipeline/run.mjs --list",
    "test:script-beats": "node --experimental-strip-types --test scripts/test-script-beats.mjs",
    "state:backfill": "node --experimental-strip-types scripts/backfill-shot-state.mjs",
    "dev:app:web": "vite --mode web",
    "build:app:web": "vite build --mode web",
    "preview": "vite preview --mode web",
    "migrate:next": "tsx scripts/migrate-next-workspace.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "openai": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^5.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^9.5.1"
  }
}
